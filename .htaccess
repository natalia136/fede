# Aventura Escolar en hosting compartido (Apache / LiteSpeed)
Options -Indexes
DirectoryIndex index.html
# Bloquea archivos privados: datos, herramientas, servidor Node y documentación
RedirectMatch 404 ^/(data|tools|node_modules|\.git)(/|$)
<FilesMatch "^(server\.js|README\.md|DEPLOY\.md|package\.json|\.gitignore|config\.json|config\.sample\.json)$">
  Require all denied
</FilesMatch>
# Fuerza HTTPS (las contraseñas viajan cifradas)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# Que el navegador siempre revise si hay una versión nueva de la página (los archivos llevan ?v=)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
